# Copy this file to `.env` and fill in your API key.
# `.env` is gitignored and should never be committed.

# Option 1: OpenAI
# export AI_QA_OPENAI_API_KEY=sk-...
# export AI_QA_OPENAI_MODEL=gpt-4o-mini

# Option 2: Anthropic
# export AI_QA_ANTHROPIC_API_KEY=sk-ant-...
# export AI_QA_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 3: 智谱 AI (Zhipu / ChatGLM)
export AI_QA_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
export AI_QA_OPENAI_API_KEY=your-zhipu-api-key
export AI_QA_OPENAI_MODEL=glm-4-flash

# Pipeline settings
export AI_QA_NUM_WORKERS=2
export AI_QA_LOG_LEVEL=INFO
